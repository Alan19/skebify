{
  "name": "skebify",
  "displayName": "Skebify",
  "version": "1.1.0",
  "description": "A more modern version of the Skeb Button extension.",
  "author": "Mark Ignacio",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "dompurify": "3.2.4",
    "plasmo": "0.90.5",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@plasmohq/prettier-plugin-sort-imports": "3.6.0",
    "@types/chrome": "0.0.202",
    "@types/dompurify": "^2.4.0",
    "@types/firefox-webext-browser": "^94.0.1",
    "@types/node": "18.11.9",
    "@types/react": "18.0.25",
    "@types/react-dom": "18.0.9",
    "prettier": "2.7.1",
    "typescript": "4.9.3"
  },
  "manifest": {
    "default_locale": "en",
    "permissions": [
      "scripting"
    ],
    "host_permissions": [
      "https://skeb.jp/api/*"
    ]
  }
}